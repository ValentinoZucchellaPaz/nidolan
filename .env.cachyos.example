# Configuración para probar localmente en CachyOS/Arch.
# Copiar a .env; no subir ese archivo al repositorio.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CAMBIAR_POR_UNA_CONTRASENA_LARGA
# Genere una clave con: openssl rand -hex 32
SESSION_SECRET=CAMBIAR_POR_64_CARACTERES_ALEATORIOS

# Datos locales de prueba, sin modificar /srv ni necesitar sudo.
DATA_DIR=./.selfdrive/data
STATE_DIR=./.selfdrive/state
# Carpeta existente del host que se mostrará sin duplicarla ni permitir cambios.
LIBRARY_PATH=/home/REEMPLAZAR/Documentos/UNC
PUID=1000
PGID=1000

# Solo esta PC: abrir http://127.0.0.1:8080
BIND_ADDRESS=127.0.0.1
HOST_PORT=8080
