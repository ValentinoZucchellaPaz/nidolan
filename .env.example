# Copiar a .env y reemplazar todos los valores de ejemplo.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CAMBIAR_POR_UNA_CONTRASENA_LARGA
# Genere una clave con: openssl rand -hex 32
SESSION_SECRET=CAMBIAR_POR_64_CARACTERES_ALEATORIOS

# Directorios persistentes del host. Deben pertenecer a PUID:PGID.
DATA_DIR=/srv/selfdrive/data
STATE_DIR=/srv/selfdrive/state
# Carpeta existente del host para mostrarla en modo solo lectura.
LIBRARY_PATH=/srv/selfdrive/library
PUID=1000
PGID=1000

# Cambiar por la IP que el router reservó para esta PC limita el servicio a esa interfaz.
BIND_ADDRESS=192.168.1.50
HOST_PORT=8080
